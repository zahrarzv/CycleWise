<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <application
        android:name=".application.PeriodTracker"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sample_project">

        <activity android:name=".presentation.SavedLogsActivity"
            android:screenOrientation="portrait"/>
        <activity android:name=".presentation.PredictionActivity"
            android:screenOrientation="portrait"/>
        <activity android:name=".presentation.RegisterActivity"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".presentation.LoginActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.PeriodLogActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:theme="@style/Theme.Sample_project" />
        <receiver android:name=".presentation.notification.NotificationReceiver"
            android:exported="false"/>

        <activity android:name=".presentation.notification.NotificationSettingsActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>

    </application>

</manifest>